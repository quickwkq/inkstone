{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkstone",
  "version": "0.3.5",
  "identifier": "com.quickwkq.inkstone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "npm run build && npm run icons",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","create":false,"title":"墨页 · Inkstone","width":1280,"height":900,"minWidth":760,"minHeight":540}],
    "security": {"csp":"default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' inkstone-image: asset: data: blob: https: http:; font-src 'self' data:; connect-src inkstone-image: ipc: http://ipc.localhost 'self'"}
  },
  "bundle": {
    "active":true,
    "targets":["app","dmg"],
    "icon":["../build/icon.icns","../build/icon.png"],
    "copyright":"© 2026 Inkstone",
    "shortDescription":"本地 Markdown 阅读编辑器",
    "fileAssociations":[{"ext":["md","markdown","txt"],"name":"Markdown document","role":"Editor"}],
    "macOS":{"signingIdentity":"-","minimumSystemVersion":"13.0","dmg":{"windowSize":{"width":640,"height":420},"appPosition":{"x":180,"y":190},"applicationFolderPosition":{"x":460,"y":190}}}
  }
}
