{
  "name": "inkstone",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "墨页 · Local-first Markdown editor",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/assets.mjs && vite build",
    "prestart": "node scripts/assets.mjs && npm run icons",
    "start": "tauri dev",
    "pack": "tauri build --bundles app",
    "test": "node --test tests/*.test.mjs",
    "icons": "node scripts/icons.mjs",
    "dist:mac": "tauri build && node scripts/collect.mjs",
    "dist:all": "tauri build --target aarch64-apple-darwin && tauri build --target x86_64-apple-darwin && node scripts/collect.mjs",
    "checksums": "node scripts/checksums.mjs",
    "pretest:native": "npm run icons",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "dompurify": "^3.4.17",
    "vditor": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "author": "kuiq W",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/quickwkq/inkstone.git"
  }
}
