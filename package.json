{
  "name": "inkstone",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "墨页 · Local-first Markdown editor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/assets.mjs && vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && npm run icons && electron-builder --mac dir --publish never",
    "test": "node --test tests/*.test.mjs",
    "icons": "node scripts/icons.mjs",
    "dist:mac": "npm run build && npm run icons && electron-builder --mac dmg zip --publish never",
    "dist:all": "npm run build && npm run icons && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "vditor": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "author": "kuiq W",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/quickwkq/inkstone.git"
  }
}
